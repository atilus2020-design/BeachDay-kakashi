# Beach Day environment variables: NAMES and FAKE formats only. Never put real values in this file.
# Real values go in the Netlify UI (Site configuration > Environment variables) or a git-ignored .env.
# Variables in netlify.toml are NOT visible to Functions; do not put secrets there.

# --- Functions scope (server only) ---------------------------------------------------------
# SECRET. Scope: Functions, all contexts (use a low-limit key for previews/dev). Mark "Contains secret values".
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# SECRET. Scope: Functions, Production context ONLY. Fine-grained PAT, contents:write on this repo only.
GITHUB_TOKEN=github_pat_REPLACE_ME
# Public. Scope: Functions. owner/name of the repo Approve commits to.
GITHUB_REPO=owner/name
# Public. Scope: Functions. Supabase project URL (https; http only under netlify dev/tests).
SUPABASE_URL=https://your-project-ref.supabase.co
# Public by design (RLS protects data). Scope: Functions.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Public. Scope: Functions. Daily budgets per user and global (security.md R11); code defaults are 100 chats and 1,000,000 tokens per day.
DAILY_CHAT_LIMIT=100
DAILY_TOKEN_LIMIT=1000000

# --- Builds scope (compiled into the browser bundle: public) -------------------------------
# Only these two VITE_* variables are allowed; scripts/check-secrets.mjs fails the build on any other.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# --- Local/test only: UNSET in production (point upstreams at tests/mocks/upstreams.mjs) ----
# OPEN_METEO_BASE=http://127.0.0.1:9100/open-meteo
# OPEN_METEO_MARINE_BASE=http://127.0.0.1:9100/marine
# ANTHROPIC_BASE_URL=http://127.0.0.1:9100/anthropic
# GITHUB_API_URL=http://127.0.0.1:9100/github

# --- Not needed in v1 (only once background jobs are built) --------------------------------
# JOB_SIGNING_SECRET=   (SECRET, Functions scope)
# DAILY_JOB_LIMIT=

# --- FORBIDDEN: must never exist anywhere (Netlify env, .env, dist/) -----------------------
# SUPABASE_SECRET_KEY / sb_secret_...     (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY / service_role
# Supabase JWT secret, CONSOLE_PASSWORD_HASH, SESSION_SECRET
# Any other VITE_* variable (it would be public).
